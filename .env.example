# Application
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_FILE=.data/mentalbridge.json

# Optional MongoDB Atlas persistence. When set, this replaces DATA_FILE.
MONGODB_URI=
MONGODB_DATABASE=mentalbridge

# Optional email delivery for password reset links.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MentalBridge <no-reply@mentalbridge.local>"

# Optional OpenAI analysis. Without this key, the safe local analyzer is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
