# Application
PORT=3001
# Runs independently from the member API. Keep this at 3002 locally.
STAFF_AUTH_PORT=3002
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_FILE=.data/mentalbridge.json

# Only needed when the frontend is served from a DIFFERENT origin than the API
# (that is the Vite dev server on :5173). After "npm start" the API serves the built
# app itself, so a single origin is used and this can stay empty.
# Comma separated. Add your LAN address when demoing on a phone in dev mode:
# CLIENT_ORIGIN=http://localhost:5173,http://192.168.0.10:5173
CLIENT_ORIGIN=http://localhost:5173
# Browser address of the separate staff authentication server. Replace this with
# the staff service's https address when building for production.
VITE_STAFF_AUTH_URL=http://127.0.0.1:3002
STAFF_AUTH_URL=http://127.0.0.1:3002

# Google Identity Services OAuth 2.0 Web client ID. The same public client ID
# is used by the member API and the separate staff authentication service.
GOOGLE_CLIENT_ID=

# Optional local or hosted MongoDB persistence. When set, this replaces DATA_FILE.
# Local example: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DATABASE=mentalbridge

# Email delivery for mandatory signup verification and password reset links.
# Use SMTP credentials from your email provider (for Gmail, use an App Password).
# SMTP_HOST is REQUIRED when NODE_ENV=production, or the server refuses to start.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MentalBridge <no-reply@mentalbridge.local>"

# Optional OpenAI analysis. Without this key, the safe local analyzer is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Preferred external analyzer for peer-support summaries. The key stays on the
# server and is never sent to the browser. Gemini is used before OpenAI when
# both keys are configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Self-hosted, no provider quotas. Install Ollama and run: ollama pull qwen2.5:1.5b
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Demo volunteers make local matching scenarios testable. Production always excludes them.
ALLOW_DEMO_MATCHES=true

# Optional operator-provisioned accounts. Owners activate using password reset.
INITIAL_ADMIN_EMAIL=
INITIAL_VOLUNTEER_EMAILS=
