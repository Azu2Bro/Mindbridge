# Application
PORT=3001
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_FILE=.data/mentalbridge.json

# Only needed when the frontend is served from a DIFFERENT origin than the API
# (that is the Vite dev server on :5173). After "npm start" the API serves the built
# app itself, so a single origin is used and this can stay empty.
# Comma separated. Add your LAN address when demoing on a phone in dev mode:
# CLIENT_ORIGIN=http://localhost:5173,http://192.168.0.10:5173
CLIENT_ORIGIN=http://localhost:5173

# Optional local or hosted MongoDB persistence. When set, this replaces DATA_FILE.
# Local example: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DATABASE=mentalbridge

# Email delivery for mandatory signup verification and password reset links.
# Use SMTP credentials from your email provider (for Gmail, use an App Password).
# SMTP_HOST is REQUIRED when NODE_ENV=production, or the server refuses to start.
APP_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MentalBridge <no-reply@mentalbridge.local>"

# Optional OpenAI analysis. Without this key, the safe local analyzer is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
